# EBK environment template. Copy to .env and fill in. NEVER commit real secrets.
# Generate secrets with:  openssl rand -base64 48   (JWT)   |   openssl rand -base64 32   (field key)

NODE_ENV=development
PORT=3000
# 127.0.0.1 when running directly on a server (not reachable from the internet); Docker overrides to 0.0.0.0
HOST=127.0.0.1

# --- Database ---
POSTGRES_USER=ebk
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ebk
DATABASE_URL=postgresql://ebk:change-me-local-only@localhost:5432/ebk?schema=public

# --- Public URLs ---
APP_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# --- Field encryption (AES-256-GCM, 32 bytes base64) ---
FIELD_ENCRYPTION_KEY=

# --- Sandbox adapters (development/staging only; refused in production) ---
SANDBOX_PROVIDERS_ENABLED=true
SANDBOX_WEBHOOK_SECRET=replace-with-random-sandbox-secret

# --- MTN MoMo Disbursement (sandbox credentials from https://momodeveloper.mtn.com/) ---
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=

# --- Compliance ---
COMPLIANCE_REVIEW_THRESHOLD_GBP=1000.00

# --- Web app (build-time) ---
VITE_API_BASE_URL=http://localhost:3000/api
